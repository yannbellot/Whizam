{
  "name": "agentic-design-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/@react-router/dev/bin.js dev --host 127.0.0.1",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "preview": "npm run start",
    "test:design-system": "node --test tests/design-system-automation.test.mjs",
    "validate:design-system": "node scripts/validate-design-system.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.ts",
    "test": "vitest run --config config/testing/vitest.config.ts",
    "pretest": "npm run tokens:generate",
    "test:boundaries": "node scripts/check-server-boundaries.mjs",
    "db:generate": "drizzle-kit generate --config config/database/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/database.ts seed",
    "test:integration": "node scripts/test-integration.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "format:check": "prettier --config .prettierrc.json --check app .storybook config src scripts tests public *.ts *.json *.js skills/catalog.json",
    "format": "prettier --config .prettierrc.json --write app .storybook config src scripts tests public *.ts *.json *.js skills/catalog.json",
    "test:e2e:install": "node scripts/test-e2e.mjs --install",
    "test:e2e": "node scripts/test-e2e.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "docs:design-system:check": "node scripts/generate-tokens.mjs --check-docs",
    "test:design-system:docs": "node --test tests/design-system-automation.test.mjs",
    "predev": "npm run tokens:generate",
    "prebuild": "npm run tokens:generate",
    "pretypecheck": "npm run tokens:generate",
    "prestorybook": "npm run tokens:generate",
    "prebuild-storybook": "npm run tokens:generate",
    "storybook": "node scripts/storybook-local.mjs dev --host 127.0.0.1 -p 6006 --no-open --disable-telemetry",
    "build-storybook": "node scripts/storybook-local.mjs build --disable-telemetry",
    "test:storybook": "node scripts/test-e2e.mjs --config config/testing/playwright.storybook.config.ts",
    "test:projects": "node scripts/test-projects.mjs",
    "validate:agent-kit": "node scripts/validate-agent-kit.mjs",
    "local:app": "node scripts/local-app.mjs",
    "test:local-app": "node --test tests/local-app.test.mjs",
    "design-system:sync": "node scripts/generate-tokens.mjs",
    "design-system:check": "node scripts/generate-tokens.mjs --check",
    "docs:prepare": "node scripts/documentation.mjs prepare",
    "docs:build": "node scripts/documentation.mjs build",
    "docs:dev": "node scripts/documentation.mjs serve",
    "docs:check": "node scripts/documentation.mjs check",
    "test:documentation": "node --test tests/documentation.test.mjs tests/documentation-languages.test.mjs tests/documentation-preference.test.mjs tests/project-intake.test.mjs",
    "docs:translations:check": "node scripts/check-documentation-translations.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.8",
    "react-grab": "0.2.0",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "^8.20.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "8.5.26",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "yaml": "^2.9.0"
  },
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.8.0 <12"
  }
}
