diff --git a/src/loomata-ui/official/Widgets.tsx b/src/loomata-ui/official/Widgets.tsx
new file mode 100644
--- /dev/null
+++ b/src/loomata-ui/official/Widgets.tsx
@@ -0,0 +1,434 @@
+import {
+  Children,
+  cloneElement,
+  isValidElement,
+  useContext,
+  createContext,
+  useId,
+  useRef,
+  useState,
+  type ComponentProps,
+  type ComponentPropsWithRef,
+  type ReactNode,
+} from 'react'
+import { mergeProps, mergeRefs, useButton, useFocusRing, useHover, useLink } from 'react-aria'
+import { Select as OfficialSelect, SelectItem } from '../../assistant/official/Select'
+import { Header, ListBoxSection } from '../../assistant/official/ListBox'
+import { ColorSwatch } from '../../assistant/official/ColorSwatch'
+import { TextField, TextArea as OfficialTextArea } from '../../assistant/official/TextField'
+import { Checkbox as OfficialCheckbox } from '../../assistant/official/Checkbox'
+import { Form as OfficialForm } from '../../assistant/official/Form'
+import { ChevronRight } from '../../assistant/official/lucide'
+import './native.css'
+const Disabled = createContext(false)
+const classes = (...values: (string | undefined | false)[]) => values.filter(Boolean).join(' ')
+export function Fieldset({ disabled, children, ...props }: ComponentPropsWithRef<'fieldset'>) {
+  const inherited = useContext(Disabled)
+  return (
+    <fieldset {...props} disabled={disabled}>
+      <Disabled.Provider value={inherited || !!disabled}>{children}</Disabled.Provider>
+    </fieldset>
+  )
+}
+export function NativeButton({
+  disabled,
+  type = 'submit',
+  className,
+  ref,
+  ...props
+}: ComponentPropsWithRef<'button'>) {
+  const inherited = useContext(Disabled),
+    isDisabled = inherited || !!disabled
+  const node = useRef<HTMLButtonElement>(null)
+  const { buttonProps, isPressed } = useButton({ type, isDisabled }, node)
+  const { focusProps, isFocusVisible } = useFocusRing()
+  const { hoverProps, isHovered } = useHover({ isDisabled })
+  const selected =
+    props['aria-pressed'] === true ||
+    props['aria-pressed'] === 'true' ||
+    props['aria-selected'] === true ||
+    props['aria-selected'] === 'true' ||
+    !!props['aria-current']
+  const toggle =
+    props['aria-pressed'] !== undefined ||
+    props['aria-selected'] !== undefined ||
+    props['aria-current'] !== undefined
+  return (
+    <button
+      {...mergeProps(buttonProps, focusProps, hoverProps, props)}
+      type={type}
+      ref={mergeRefs(node, ref)}
+      disabled={isDisabled}
+      className={classes(
+        toggle ? 'react-aria-ToggleButton' : 'react-aria-Button',
+        'button-base',
+        className,
+      )}
+      data-variant="primary"
+      data-disabled={isDisabled || undefined}
+      data-pressed={isPressed || undefined}
+      data-hovered={isHovered || undefined}
+      data-focus-visible={isFocusVisible || undefined}
+      data-selected={selected || undefined}
+    />
+  )
+}
+export function Button(props: ComponentPropsWithRef<'button'>) {
+  return <NativeButton {...props} type={props.type ?? 'button'} />
+}
+function NativeTextInput({
+  disabled,
+  className,
+  type = 'text',
+  ...props
+}: ComponentPropsWithRef<'input'>) {
+  const inherited = useContext(Disabled),
+    { focusProps, isFocused, isFocusVisible } = useFocusRing()
+  return (
+    <input
+      {...mergeProps(focusProps, props)}
+      type={type}
+      disabled={disabled || inherited}
+      className={classes('react-aria-Input', 'inset', className)}
+      data-focused={isFocused || undefined}
+      data-focus-visible={isFocusVisible || undefined}
+      data-disabled={disabled || inherited || undefined}
+      data-invalid={props['aria-invalid'] === true || props['aria-invalid'] === 'true' || undefined}
+    />
+  )
+}
+export function Input(props: ComponentPropsWithRef<'input'>) {
+  if (props.type === 'color')
+    return (
+      <span className="official-color-control">
+        <ColorSwatch
+          color={String(props.value ?? props.defaultValue ?? '#000000')}
+          aria-hidden="true"
+        />
+        <NativeTextInput {...props} className="official-color-native" />
+      </span>
+    )
+  return <NativeTextInput {...props} />
+}
+export function TextArea({ disabled, className, ...props }: ComponentPropsWithRef<'textarea'>) {
+  const inherited = useContext(Disabled),
+    { focusProps, isFocused, isFocusVisible } = useFocusRing()
+  return (
+    <textarea
+      {...mergeProps(focusProps, props)}
+      disabled={disabled || inherited}
+      className={classes('react-aria-TextArea', 'inset', className)}
+      data-focused={isFocused || undefined}
+      data-focus-visible={isFocusVisible || undefined}
+      data-disabled={disabled || inherited || undefined}
+      data-invalid={props['aria-invalid'] === true || props['aria-invalid'] === 'true' || undefined}
+    />
+  )
+}
+type Option = {
+  key: string
+  value: string
+  label: ReactNode
+  text: string
+  disabled: boolean
+  group: string
+}
+function textOf(node: ReactNode): string {
+  return Children.toArray(node)
+    .map((n) =>
+      isValidElement<{ children?: ReactNode }>(n) ? textOf(n.props.children) : String(n),
+    )
+    .join('')
+}
+function optionsOf(children: ReactNode, group = '', out: Option[] = []): Option[] {
+  Children.forEach(children, (child) => {
+    if (
+      !isValidElement<{
+        children?: ReactNode
+        value?: string | number
+        disabled?: boolean
+        label?: string
+      }>(child)
+    )
+      return
+    if (child.type === 'option')
+      out.push({
+        key: 'option-' + out.length,
+        value: String(child.props.value ?? textOf(child.props.children)),
+        label: child.props.children,
+        text: textOf(child.props.children),
+        disabled: !!child.props.disabled,
+        group,
+      })
+    else
+      optionsOf(
+        child.props.children,
+        child.type === 'optgroup' ? (child.props.label ?? '') : group,
+        out,
+      )
+  })
+  return out
+}
+type SelectProps = ComponentPropsWithRef<'select'> & { label?: ReactNode }
+export function Select({
+  children,
+  value,
+  defaultValue,
+  onChange,
+  disabled,
+  required,
+  label,
+  className,
+  id,
+  ref,
+  ...props
+}: SelectProps) {
+  const inherited = useContext(Disabled),
+    generated = useId(),
+    native = useRef<HTMLSelectElement>(null)
+  const options = optionsOf(children),
+    [local, setLocal] = useState(String(defaultValue ?? options[0]?.value ?? ''))
+  const selected = options.find((o) => o.value === String(value ?? local)) ?? options[0]
+  const groups = [...new Set(options.map((o) => o.group))]
+  const item = (o: Option) => (
+    <SelectItem key={o.key} id={o.key} isDisabled={o.disabled} textValue={o.text}>
+      {o.label}
+    </SelectItem>
+  )
+  return (
+    <>
+      <OfficialSelect
+        id={id ?? generated}
+        label={label ? textOf(label) : undefined}
+        aria-label={
+          label ? undefined : (props['aria-label'] ?? props.name ?? props.title ?? 'Sélection')
+        }
+        aria-labelledby={props['aria-labelledby']}
+        aria-describedby={props['aria-describedby']}
+        name={props.name}
+        form={props.form}
+        isDisabled={disabled || inherited}
+        isRequired={required}
+        autoFocus={props.autoFocus}
+        selectedKey={selected?.key ?? null}
+        onSelectionChange={(key) => {
+          const choice = options.find((o) => o.key === key)
+          if (!choice || !native.current) return
+          native.current.value = choice.value
+          native.current.dispatchEvent(new Event('change', { bubbles: true }))
+          if (value === undefined) setLocal(choice.value)
+        }}
+      >
+        {groups.map((group) =>
+          group ? (
+            <ListBoxSection key={group} id={'group-' + group}>
+              <Header>{group}</Header>
+              {options.filter((o) => o.group === group).map(item)}
+            </ListBoxSection>
+          ) : (
+            options.filter((o) => !o.group).map(item)
+          ),
+        )}
+      </OfficialSelect>
+      <select
+        {...props}
+        id={(id ?? generated) + '-native'}
+        name={undefined}
+        required={false}
+        hidden
+        aria-hidden="true"
+        tabIndex={-1}
+        ref={mergeRefs(native, ref)}
+        value={selected?.value ?? ''}
+        disabled={disabled || inherited}
+        onChange={onChange}
+        className={className}
+      >
+        {children}
+      </select>
+    </>
+  )
+}
+export function Label({ children, className, htmlFor, ...props }: ComponentPropsWithRef<'label'>) {
+  const items = Children.toArray(children),
+    selectIndex = items.findIndex((c) => isValidElement<SelectProps>(c) && c.type === Select)
+  if (selectIndex >= 0) {
+    const control = items[selectIndex]
+    if (isValidElement<SelectProps>(control))
+      return (
+        <div className={className}>
+          {cloneElement(control, { label: items.slice(0, selectIndex) })}
+          {items.slice(selectIndex + 1)}
+        </div>
+      )
+  }
+  const inputIndex = items.findIndex(
+    (c) => isValidElement(c) && (c.type === Input || c.type === TextArea),
+  )
+  if (inputIndex >= 0)
+    return (
+      <label {...props} htmlFor={htmlFor} className={classes('react-aria-TextField', className)}>
+        <span className="react-aria-Label">{items.slice(0, inputIndex)}</span>
+        {items.slice(inputIndex)}
+      </label>
+    )
+  return (
+    <label {...props} htmlFor={htmlFor} className={classes('react-aria-Label', className)}>
+      {children}
+    </label>
+  )
+}
+export function Summary({ children, className, ...props }: ComponentPropsWithRef<'summary'>) {
+  return (
+    <summary {...props} className={classes('disclosure-button', className)}>
+      <ChevronRight size={16} />
+      <span>{children}</span>
+    </summary>
+  )
+}
+export function Details({
+  children,
+  open,
+  onToggle,
+  className,
+  ...props
+}: ComponentPropsWithRef<'details'>) {
+  const [expanded, setExpanded] = useState(!!open),
+    items = Children.toArray(children),
+    summary = items.find((c) => isValidElement(c) && c.type === Summary)
+  return (
+    <details
+      {...props}
+      open={open}
+      className={classes('react-aria-Disclosure', className)}
+      data-expanded={expanded || undefined}
+      onToggle={(e) => {
+        setExpanded(e.currentTarget.open)
+        onToggle?.(e)
+      }}
+    >
+      {summary}
+      <div className="react-aria-DisclosurePanel">
+        <div>{items.filter((c) => c !== summary)}</div>
+      </div>
+    </details>
+  )
+}
+export function Dialog({ children, className, ...props }: ComponentPropsWithRef<'dialog'>) {
+  const workspace = props['aria-labelledby'] === 'figma-explorer-title'
+  return (
+    <dialog
+      {...props}
+      className={classes(
+        workspace ? 'official-workspace-dialog' : 'react-aria-Modal',
+        'official-native-dialog',
+        className,
+      )}
+    >
+      <div className="react-aria-Dialog">{children}</div>
+    </dialog>
+  )
+}
+export function H1({ className, ...p }: ComponentPropsWithRef<'h1'>) {
+  return <h1 {...p} className={classes('react-aria-Heading', className)} />
+}
+export function H2({ className, ...p }: ComponentPropsWithRef<'h2'>) {
+  return <h2 {...p} className={classes('react-aria-Heading', className)} />
+}
+export function H3({ className, ...p }: ComponentPropsWithRef<'h3'>) {
+  return <h3 {...p} className={classes('react-aria-Heading', className)} />
+}
+export function Form(p: ComponentProps<typeof OfficialForm>) {
+  return <OfficialForm {...p} />
+}
+export function Checkbox(p: ComponentProps<typeof OfficialCheckbox>) {
+  const inherited = useContext(Disabled)
+  return <OfficialCheckbox {...p} isDisabled={p.isDisabled || inherited} />
+}
+export function Link({ className, ref, ...props }: ComponentPropsWithRef<'a'>) {
+  const node = useRef<HTMLAnchorElement>(null),
+    { linkProps, isPressed } = useLink({ href: props.href, target: props.target }, node),
+    { focusProps, isFocusVisible } = useFocusRing(),
+    { hoverProps, isHovered } = useHover({})
+  return (
+    <a
+      {...mergeProps(linkProps, focusProps, hoverProps, props)}
+      ref={mergeRefs(node, ref)}
+      className={classes('react-aria-Link', className)}
+      data-pressed={isPressed || undefined}
+      data-hovered={isHovered || undefined}
+      data-focus-visible={isFocusVisible || undefined}
+    />
+  )
+}
+export function Field({
+  label,
+  error,
+  hint,
+  multiline,
+  disabled,
+  required,
+  ...props
+}: {
+  name: string
+  label: string
+  defaultValue?: string
+  error?: string
+  hint?: string
+  multiline?: boolean
+  disabled?: boolean
+  required?: boolean
+  maxLength?: number
+}) {
+  const inherited = useContext(Disabled),
+    Control = multiline ? OfficialTextArea : TextField
+  return (
+    <Control
+      {...props}
+      label={label}
+      description={hint}
+      errorMessage={error}
+      isInvalid={!!error}
+      isDisabled={disabled || inherited}
+      isRequired={required}
+      validationBehavior="aria"
+    />
+  )
+}
+export function SelectField({
+  label,
+  name,
+  options,
+  disabled,
+}: {
+  label: string
+  name: string
+  options: string[]
+  disabled?: boolean
+}) {
+  return (
+    <Select label={label} name={name} disabled={disabled}>
+      {options.map((o) => (
+        <option key={o} value={o}>
+          {o}
+        </option>
+      ))}
+    </Select>
+  )
+}
+export function Panel({ children }: { children: ReactNode }) {
+  return <section className="react-aria-Form">{children}</section>
+}
+export function Notice({
+  children,
+  tone = 'info',
+}: {
+  children: ReactNode
+  tone?: 'info' | 'success' | 'error'
+}) {
+  return (
+    <div className="react-aria-Form">
+      <div role={tone === 'error' ? 'alert' : 'status'}>{children}</div>
+    </div>
+  )
+}
diff --git a/src/loomata-ui/official/native.css b/src/loomata-ui/official/native.css
new file mode 100644
--- /dev/null
+++ b/src/loomata-ui/official/native.css
@@ -0,0 +1,73 @@
+/* Native-contract adapters: no component palette or visual scale is authored here. */
+.loomata-official-ui {
+  --page-width: 100vw;
+  --page-height: 100dvh;
+  --visual-viewport-height: 100dvh;
+  color: var(--text-color);
+  background: var(--background-color);
+  margin: 0;
+}
+.loomata-official-ui fieldset {
+  border: 0;
+  padding: 0;
+  margin: 0;
+  min-width: 0;
+}
+.official-color-control {
+  position: relative;
+  display: inline-flex;
+}
+.official-color-native.react-aria-Input {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  opacity: 0;
+  padding: 0;
+  border: 0;
+  cursor: pointer;
+}
+.official-color-control:focus-within {
+  outline: 2px solid var(--focus-ring-color);
+}
+dialog.official-native-dialog {
+  border: 0;
+  padding: 0;
+  inset: auto;
+  top: 50%;
+  left: 50%;
+  margin: 0;
+  position: fixed;
+  translate: -50% -50%;
+}
+dialog.official-native-dialog::backdrop {
+  background: rgba(0 0 0 / 0.5);
+}
+dialog.official-workspace-dialog {
+  inset: var(--spacing-4);
+  translate: none;
+  width: auto;
+  height: auto;
+  max-width: none;
+  max-height: none;
+  color: var(--text-color);
+  background: var(--overlay-background);
+}
+dialog.official-workspace-dialog > .react-aria-Dialog {
