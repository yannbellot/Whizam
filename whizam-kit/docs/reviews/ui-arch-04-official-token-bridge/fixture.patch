+import test from 'node:test';import assert from 'node:assert/strict';
+import {parseOfficialColor} from '../src/design-system/editor/official-color.ts';
+import {normalizeValue} from '../src/design-system/editor/contract.ts';
+import {primitiveName} from '../src/design-system/editor/naming.ts';
+import {editorValue,tokenCSS,validateTokenValue} from '../scripts/dtcg-tokens.mjs';
+import {isReviewedOfficialStyle} from '../scripts/official-style-audit.mjs';
+import fs from 'node:fs';
+test('Official OKLCH is lossless through editor, naming and typed DTCG',()=>{
+ for(const value of ['oklch(1 0.25049 284.23)','oklch(0.5 0 0)','oklch(0.6 0.181447 27.0726)','oklch(0.7 0.15 150)']){
+ assert(parseOfficialColor(value));assert.equal(normalizeValue({type:'color'},value,[]),value);const dtcg=editorValue('color',value);assert.equal(tokenCSS(dtcg.type,dtcg.value),value);assert.match(primitiveName('color',value),/^primitive.color.oklch-/);
+ }
+ assert.equal(normalizeValue({type:'color'},'#AbC',[]),'#aabbcc');assert.equal(primitiveName('color','#aabbcc'),'primitive.color.hex-aabbcc');
+});
+test('Expressions, invalid channels and alpha are refused',()=>{
+ for(const value of ['oklch(2 0 0)','oklch(1 -1 0)','oklch(1 0 361)','oklch(NaN 0 0)','oklch(1 0 0 / 0.5)','oklch(from red l c h)','red; color:blue'])assert.throws(()=>normalizeValue({type:'color'},value,[]));
+ for(const value of [{colorSpace:'oklch',components:['1',0.1,0]},{colorSpace:'oklch',components:[1,0.1,0],alpha:0.5},{colorSpace:'oklch',components:[1,NaN,0]}])assert.throws(()=>validateTokenValue('color',value));
+ assert.notEqual(primitiveName('color','oklch(1 0.25 28.4)'),primitiveName('color','oklch(1 0.254 28)'));
+});
+test('Vendor boundary rejects modified CSS rather than exempting a directory',()=>{
+ const file='src/react-aria-examples/utilities.css';const source=fs.readFileSync(new URL('../'+file,import.meta.url),'utf8');assert(isReviewedOfficialStyle(file,source));assert.throws(()=>isReviewedOfficialStyle(file,source+'\n.x{color:red}'));assert.equal(isReviewedOfficialStyle('src/other.css',source),false);
+});
