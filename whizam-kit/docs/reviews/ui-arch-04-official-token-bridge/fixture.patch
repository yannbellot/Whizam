+import { createHash } from 'node:crypto'
+// Closed vendor boundary: reviewed Adobe rules and their exact token adapters.
+// Mutable design values remain exclusively in DTCG; edits to these rules require a code revision.
+const reviewed = {
+  'src/react-aria-examples/Button.css':
+    'd9d1180f72d9d982df22f396d820adf7d5399b25035bcaa7d50acaaa445df327',
+  'src/react-aria-examples/Content.css':
+    '48a0f685881b4692925f6e30b57edb0c8b24ce1edad395dd790fabd611201898',
+  'src/react-aria-examples/Form.css':
+    '72eb66c7b0cfc10fbf79309454acc2b34ed633ee91f464dc03fbfcc2b935cc6d',
+  'src/react-aria-examples/TextField.css':
+    'abe42d68d7a661f64ffe42d30d3aff1bf7481f74177a2b3d289fa09197b9ba11',
+  'src/react-aria-examples/page.css':
+    '5e265073b991a13f507e1740ac142897ecfe50377116a67cba39133857f52376',
+  'src/react-aria-examples/theme.css':
+    '38e1861b5b30d7b894fb6f2ca853b9674fbd4d720f6e7db4dbee805f27e444b9',
+  'src/react-aria-examples/utilities.css':
+    '97df44ee6db140bb92546efbfb7456f245a489ff837428e049800dcab24fb799',
+}
+export function isReviewedOfficialStyle(file, text) {
+  if (!Object.hasOwn(reviewed, file)) return false
+  if (createHash('sha256').update(text).digest('hex') !== reviewed[file])
+    throw new Error('Official style differs from reviewed token adapter: ' + file)
+  return true
+}
