@@ -0,0 +1,22 @@
+/** Closed literal OKLCH profile for the official React Aria fixture; no expressions. */
+export function parseOfficialColor(value: unknown): number[] | null {
+  if (typeof value !== 'string') return null
+  const match =
+    /^oklch\(([-+]?\d+(?:\.\d{1,6})?) ([-+]?\d+(?:\.\d{1,6})?) ([-+]?\d+(?:\.\d{1,6})?)\)$/.exec(
+      value,
+    )
+  if (!match) return null
+  const channels = match.slice(1).map(Number)
+  const [lightness, chroma, hue] = channels
+  if (
+    !channels.every(Number.isFinite) ||
+    lightness < 0 ||
+    lightness > 1 ||
+    chroma < 0 ||
+    hue < 0 ||
+    hue > 360
+  )
+    return null
+  return channels
+}
+export const officialColorCSS = (channels: number[]) => `oklch(${channels.join(' ')})`
