{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "types"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "validation"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "const": "property-specific"
          }
        }
      }
    }
  }
}
