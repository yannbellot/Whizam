+import { isRouteErrorResponse, useRouteError } from 'react-router'
+import { Notice } from '../../../src/design-system/components/Notice'
+import styles from '../projects/projects.module.css'
+export function LoanErrorBoundary() {
+  const error = useRouteError()
+  const status = isRouteErrorResponse(error) ? error.status : 500
+  const title =
+    status === 503
+      ? 'Inventaire temporairement indisponible'
+      : status === 404
+        ? 'Objet introuvable'
+        : status === 400 || status === 403
+          ? 'Requête refusée'
+          : 'Une erreur est survenue'
+  return (
+    <main className={styles.page}>
+      <h1>{title}</h1>
+      <Notice tone="error">
+        {status === 503
+          ? 'Le stockage ne répond pas. Réessayez après son rétablissement.'
+          : 'La demande n’a pas abouti. Revenez à l’inventaire pour poursuivre.'}
+      </Notice>
+      <p>
+        <a href="/">Réessayer l’inventaire</a>
+      </p>
+      <p className={styles.limit}>
+        Aucune action de prêt ou de restitution n’est relancée automatiquement.
+      </p>
+    </main>
+  )
+}
