+++ b/app/routes/loans-new.tsx
@@ -0,0 +1,52 @@
+import { useEffect, useRef } from 'react'
+import { Form, Link, useActionData, useNavigation } from 'react-router'
+import { Button } from '../../src/design-system/components/Button'
+import { Field } from '../../src/design-system/components/Field'
+import { Notice } from '../../src/design-system/components/Notice'
+import { createObject } from '../features/loans/routes.server'
+import styles from '../features/projects/projects.module.css'
+import type { Route } from './+types/loans-new'
+export const action = ({ request }: Route.ActionArgs) => createObject(request)
+export const meta = () => [{ title: 'Ajouter un objet — Prêts d’objets' }]
+export default function AddObject() {
+  const feedback = useActionData<typeof action>()
+  const navigation = useNavigation()
+  const summary = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    if (feedback) summary.current?.focus()
+  }, [feedback])
+  return (
+    <main className={styles.page}>
+      <h1>Ajouter un objet</h1>
+      <Form method="post" className={styles.form}>
+        {feedback && (
+          <div ref={summary} tabIndex={-1}>
+            <Notice tone="error">{feedback.message}</Notice>
+          </div>
+        )}
+        <Field
+          name="name"
+          label="Titre de l’objet"
+          defaultValue={feedback?.values.name}
+          required
+          maxLength={100}
+          error={feedback?.errors.name}
+        />
+        <Field
+          name="category"
+          label="Catégorie"
+          defaultValue={feedback?.values.category}
+          required
+          maxLength={60}
+          error={feedback?.errors.category}
+        />
+        <div className={styles.actions}>
+          <Button type="submit" loading={navigation.state === 'submitting'}>
+            Ajouter l’objet
+          </Button>
+          <Link to="/">Annuler</Link>
+        </div>
+      </Form>
+    </main>
+  )
+}
