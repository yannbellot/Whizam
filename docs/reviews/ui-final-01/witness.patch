index 0000000..7b3de0e
--- /dev/null
+++ b/app/features/loans/routes.server.ts
@@ -0,0 +1,90 @@
+import { data, redirect } from 'react-router'
+import { assertLocalRequest, parseObjectId, readLoanForm } from './http.server.ts'
+import { objectInput, borrowerInput } from './contracts.ts'
+import type { Feedback } from './contracts.ts'
+import * as repository from './repository.server.ts'
+const headers = { 'Cache-Control': 'no-store' }
+function failure(
+  values: Record<string, string>,
+  message: string,
+  status = 503,
+  errors: Feedback['errors'] = {},
+) {
+  return data<Feedback>({ values, errors, message }, { status, headers })
+}
+function missing() {
+  return new Response('Objet introuvable.', { status: 404, headers })
+}
+export async function loadInventory(request: Request) {
+  assertLocalRequest(request)
+  const filter = new URL(request.url).searchParams.get('availability') ?? 'all'
+  if (!['all', 'available', 'loaned'].includes(filter))
+    throw new Response('Filtre invalide.', { status: 400, headers })
+  try {
+    return data({ objects: await repository.listObjects(filter), filter }, { headers })
+  } catch {
+    throw new Response('Inventaire indisponible. Réessayez.', { status: 503, headers })
+  }
+}
+export async function loadObject(request: Request, value: unknown) {
+  assertLocalRequest(request)
+  const id = parseObjectId(value)
+  let object
+  try {
+    object = await repository.findObject(id)
+  } catch {
+    throw new Response('Stockage indisponible.', { status: 503, headers })
+  }
+  if (!object) throw missing()
+  return data({ object }, { headers })
+}
+export async function createObject(request: Request) {
+  const values = await readLoanForm(request)
+  const parsed = objectInput.safeParse({ name: values.name ?? '', category: values.category ?? '' })
+  if (!parsed.success)
+    return failure(
+      values,
+      'Vérifiez les champs indiqués.',
+      400,
+      Object.fromEntries(
+        Object.entries(parsed.error.flatten().fieldErrors).map(([k, v]) => [k, v?.[0]]),
+      ),
+    )
+  try {
+    const id = await repository.addObject(parsed.data)
+    return redirect(`/objects/${id}?notice=created`, { status: 303, headers })
+  } catch {
+    return failure(values, 'Stockage indisponible. Votre saisie est conservée.', 503)
+  }
+}
+export async function changeLoan(request: Request, value: unknown) {
+  const id = parseObjectId(value)
+  const values = await readLoanForm(request)
+  if (!['borrow', 'return'].includes(values.operation))
+    throw new Response('Action invalide.', { status: 400, headers })
+  const parsed = borrowerInput.safeParse({ alias: values.alias ?? '' })
+  if (values.operation === 'borrow' && !parsed.success)
+    return failure(values, 'Vérifiez les champs indiqués.', 400, {
+      alias: parsed.error.flatten().fieldErrors.alias?.[0],
+    })
+  try {
+    if (!(await repository.findObject(id))) throw missing()
+    if (values.operation === 'borrow')
+      await repository.borrowObject(id, parsed.success ? parsed.data.alias : '')
+    else if (!(await repository.returnObject(id)))
+      return failure(values, 'Cet objet est déjà disponible. Rechargez sa fiche.', 409)
+    return redirect(
+      `/objects/${id}?notice=${values.operation === 'borrow' ? 'borrowed' : 'returned'}`,
+      { status: 303, headers },
+    )
+  } catch (error) {
+    if (error instanceof Response) throw error
+    if (repository.isConflict(error))
+      return failure(values, 'Cet objet est déjà prêté. Rechargez sa fiche.', 409)
+    return failure(
+      values,
+      'Action impossible : stockage indisponible. Votre saisie est conservée.',
+      503,
+    )
+  }
+}
