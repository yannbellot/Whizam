diff --git a/scripts/test-loans.mjs b/scripts/test-loans.mjs
new file mode 100644
index 0000000..0890539
--- /dev/null
+++ b/scripts/test-loans.mjs
@@ -0,0 +1,169 @@
+import assert from 'node:assert/strict'
+import { mkdirSync, copyFileSync, cpSync } from 'node:fs'
+import { randomBytes, randomUUID } from 'node:crypto'
+import { spawnSync } from 'node:child_process'
+import { createServer } from 'node:net'
+import { dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { setTimeout as delay } from 'node:timers/promises'
+import process from 'node:process'
+import postgres from 'postgres'
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+const runId = randomUUID().replaceAll('-', '')
+const label = 'org.agentic-design.e2e'
+const databaseName = `adl_e2e_${runId}`
+const password = randomBytes(24).toString('base64url')
+const reserve = createServer()
+let networkId
+let containerId
+let volumeId
+function docker(args, options = {}) {
+  const result = spawnSync('docker', args, { encoding: 'utf8', timeout: 30000, ...options })
+  if (result.status !== 0) throw new Error(`Owned test Docker operation failed: ${args[0]}`)
+  return result.stdout.trim()
+}
+try {
+  await new Promise((accept, reject) => {
+    reserve.once('error', reject)
+    reserve.listen(0, '127.0.0.1', accept)
+  })
+  const address = reserve.address()
+  assert.ok(address && typeof address !== 'string')
+  await new Promise((accept, reject) =>
+    reserve.close((error) => (error ? reject(error) : accept())),
+  )
+  networkId = docker(['network', 'create', '--label', `${label}=${runId}`, `adl-e2e-${runId}`])
+  const volumeName = `adl-e2e-data-${runId}`
+  assert.notEqual(
+    spawnSync('docker', ['volume', 'inspect', volumeName], { stdio: 'ignore' }).status,
+    0,
+    'Disposable volume identity already exists',
+  )
+  volumeId = docker(['volume', 'create', '--label', `${label}=${runId}`, volumeName])
+  containerId = docker(
+    [
+      'run',
+      '--detach',
+      '--name',
+      `adl-e2e-postgres-${runId}`,
+      '--label',
+      `${label}=${runId}`,
+      '--network',
+      networkId,
+      '--publish',
+      `127.0.0.1:${address.port}:5432`,
+      '--memory',
+      '512m',
+      '--mount',
+      `type=volume,src=${volumeId},dst=/var/lib/postgresql`,
+      '--env',
+      'POSTGRES_USER=lab_test',
+      '--env',
+      `POSTGRES_DB=${databaseName}`,
+      '--env',
+      'POSTGRES_PASSWORD',
+      '--env',
+      'POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256',
+      'postgres:18.6-bookworm',
+    ],
+    { env: { ...process.env, POSTGRES_PASSWORD: password } },
+  )
+  const databaseUrl = `postgresql://lab_test:${password}@127.0.0.1:${address.port}/${databaseName}`
+  const probe = postgres(databaseUrl, { max: 1, connect_timeout: 1 })
+  try {
+    const deadline = Date.now() + 30000
+    while (true) {
+      try {
+        await probe`select 1`
+        break
+      } catch {
+        if (Date.now() >= deadline) throw new Error('Owned test PostgreSQL readiness failed')
+        await delay(250)
+      }
+    }
+  } finally {
+    await probe.end({ timeout: 2 })
+  }
+  const env = {
+    ...process.env,
+    DATABASE_URL: databaseUrl,
+    ADL_LOANS_DATABASE_URL: databaseUrl,
+    ADL_E2E_RUN_ID: runId,
+    ADL_E2E_DATABASE_ID: containerId,
+    ADL_LOANS_TEST: '1',
+    ADL_E2E_RESTART: '0',
+  }
+  const migration = spawnSync(process.execPath, ['scripts/database.ts', 'migrate'], {
+    cwd: root,
+    env,
+    stdio: 'inherit',
+    timeout: 30000,
+  })
+  assert.equal(migration.status, 0, 'Owned browser database migration failed')
+  function campaign(extraEnv = {}) {
+    const result = spawnSync(
+      process.execPath,
+      [
+        'scripts/test-e2e.mjs',
+        '--config',
+        'config/testing/playwright.loans.config.ts',
+        ...process.argv.slice(2),
+      ],
+      { cwd: root, env: { ...env, ...extraEnv }, stdio: 'inherit', timeout: 240000 },
+    )
+    if (result.error) throw result.error
+    assert.equal(result.status, 0, 'Project browser campaign failed')
+  }
+  campaign()
+  const evidence = resolve(root, '.runtime.local', `loans-proof-${runId}`)
+  mkdirSync(evidence, { recursive: true })
+  cpSync(resolve(root, 'test-results'), resolve(evidence, 'flows'), { recursive: true })
+  const reader = postgres(databaseUrl, { max: 1, connect_timeout: 5 })
+  let persisted
+  try {
+    ;[persisted] =
+      await reader`select o.id, o.name, l.alias from loan_objects o join object_loans l on l.object_id=o.id where l.returned_at is null order by o.created_at limit 1`
+  } finally {
+    await reader.end({ timeout: 2 })
+  }
+  assert.ok(persisted, 'Persisted restart fixture missing')
+  // The first Playwright server was stopped; the next invocation starts a new application process.
+  campaign({
+    ADL_E2E_RESTART: '1',
+    ADL_E2E_RESTART_ID: persisted.id,
+    ADL_E2E_RESTART_NAME: persisted.name,
+    ADL_E2E_RESTART_ALIAS: persisted.alias,
+  })
+  copyFileSync(resolve(root, 'test-results/loans-restart.json'), resolve(evidence, 'restart.json'))
+  console.log(`Project campaign evidence: .runtime.local/loans-proof-${runId}`)
+  console.log('PASS: loan flows and persistence across application restart')
+} finally {
+  reserve.close()
+  if (containerId) {
+    assert.equal(
+      docker(['inspect', '--format', `{{index .Config.Labels "${label}"}}`, containerId]),
+      runId,
+    )
+    if (docker(['inspect', '--format', '{{.State.Running}}', containerId]) === 'true')
+      docker(['stop', '--time', '5', containerId])
+    docker(['rm', containerId])
+  }
+  if (volumeId) {
+    assert.equal(
+      docker(['volume', 'inspect', '--format', `{{index .Labels "${label}"}}`, volumeId]),
+      runId,
+    )
+    docker(['volume', 'rm', volumeId])
+  }
+  if (networkId) {
+    assert.equal(
+      docker(['network', 'inspect', '--format', `{{index .Labels "${label}"}}`, networkId]),
+      runId,
+    )
+    docker(['network', 'rm', networkId])
+  }
+  console.log(
+    'Owned browser test database, volume and network cleaned; no pre-existing resource targeted',
+  )
+}
