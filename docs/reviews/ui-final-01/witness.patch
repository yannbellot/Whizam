diff --git a/tests/loans/flows.spec.ts b/tests/loans/flows.spec.ts
new file mode 100644
index 0000000..da7e911
--- /dev/null
+++ b/tests/loans/flows.spec.ts
@@ -0,0 +1,57 @@
+import { test, expect } from '@playwright/test'
+import type { Page } from '@playwright/test'
+async function create(page: Page, name: string) {
+  await page.goto('/objects/new')
+  await page.getByLabel('Titre de l’objet').fill(name)
+  await page.getByLabel('Catégorie').fill('Outils démo')
+  await page.getByRole('button', { name: 'Ajouter l’objet', exact: true }).click()
+  await expect(page.getByRole('heading', { name, exact: true })).toBeVisible()
+  return page.url().split('?')[0]
+}
+function name(title: string, project: string) {
+  return `${title} ${process.env.ADL_E2E_RUN_ID} ${project}`
+}
+test('real create, validation, loan and return', async ({ page }, info) => {
+  await page.goto('/objects/new')
+  await page.locator('form').evaluate((f) => ((f as HTMLFormElement).noValidate = true))
+  await page.getByLabel('Catégorie').fill('Outils démo')
+  await page.getByRole('button', { name: 'Ajouter l’objet', exact: true }).click()
+  await expect(page.getByText('Saisissez un titre.', { exact: true })).toBeVisible()
+  await expect(page.getByLabel('Catégorie')).toHaveValue('Outils démo')
+  const title = name('Objet cycle', info.project.name)
+  await page.getByLabel('Titre de l’objet').fill(title)
+  await page.getByRole('button', { name: 'Ajouter l’objet', exact: true }).click()
+  await expect(page.getByRole('heading', { name: title, exact: true })).toBeVisible()
+  await page.getByLabel('Alias de démonstration').fill('Alias fictif')
+  await page.getByRole('button', { name: 'Prêter cet objet', exact: true }).click()
+  await expect(page.getByText('Prêté à Alias fictif', { exact: true })).toBeVisible()
+  await page.reload()
+  await expect(page.getByText('Prêté à Alias fictif', { exact: true })).toBeVisible()
+  await page.getByRole('button', { name: 'Restituer l’objet', exact: true }).click()
+  await expect(page.getByText('Disponible', { exact: true })).toBeVisible()
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
+})
+test('concurrent requests allow only one loan and deny foreign origin', async ({ page }, info) => {
+  const url = await create(page, name('Objet concurrent', info.project.name))
+  const origin = new URL(url).origin
+  const post = (alias: string, site = origin) =>
+    page.request.post(url, {
+      form: { operation: 'borrow', alias },
+      headers: { Origin: site },
+      maxRedirects: 0,
+    })
+  expect([400, 403]).toContain((await post('Intrus', 'https://other.invalid')).status())
+  const responses = await Promise.all([post('Alias A'), post('Alias B')])
+  expect(responses.map((r) => r.status()).sort()).toEqual([303, 409])
+  await page.reload()
+  await expect(page.getByText(/^Prêté à Alias [AB]$/)).toBeVisible()
+})
+test('cancel and invalid identities do not create a record', async ({ page, request }) => {
+  await page.goto('/objects/new')
+  await page.getByLabel('Titre de l’objet').fill('Non enregistré')
+  await page.getByRole('link', { name: 'Annuler', exact: true }).click()
+  await expect(page.getByRole('link', { name: 'Non enregistré', exact: true })).toHaveCount(0)
+  expect((await request.get('/objects/not-a-uuid')).status()).toBe(400)
+  expect((await request.get('/objects/11111111-1111-4111-8111-111111111111')).status()).toBe(404)
+  expect((await request.post('/__design-system/editor/save', { data: {} })).status()).toBe(404)
+})
