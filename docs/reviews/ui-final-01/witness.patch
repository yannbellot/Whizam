+import { Link, useLoaderData } from 'react-router'
+import { ObjectCard } from '../features/loans/ObjectCard'
+import { loadInventory } from '../features/loans/routes.server'
+import styles from '../features/projects/projects.module.css'
+import type { Route } from './+types/loans-index'
+export const loader = ({ request }: Route.LoaderArgs) => loadInventory(request)
+export const meta = () => [{ title: 'Inventaire — Prêts d’objets' }]
+export default function Inventory() {
+  const { objects, filter } = useLoaderData<typeof loader>()
+  return (
+    <main className={styles.page}>
+      <header className={styles.heading}>
+        <div>
+          <h1>Prêts d’objets</h1>
+          <p>Gardez le fil des objets disponibles et des prêts en cours.</p>
+        </div>
+        <Link className={styles.primaryLink} to="/objects/new">
+          Ajouter un objet
+        </Link>
+      </header>
+      <nav className={styles.navigation} aria-label="Disponibilité">
+        {[
+          ['all', 'Tous'],
+          ['available', 'Disponibles'],
+          ['loaned', 'Prêtés'],
+        ].map(([value, label]) => (
+          <Link
+            key={value}
+            to={`/?availability=${value}`}
+            aria-current={filter === value ? 'page' : undefined}
+          >
+            {label}
+          </Link>
+        ))}
+      </nav>
+      {!objects.length ? (
+        <p role="status">Aucun objet dans cette sélection.</p>
+      ) : (
+        <ul className={styles.list}>
+          {objects.map((object) => (
+            <li key={object.id}>
