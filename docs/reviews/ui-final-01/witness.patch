+import { useEffect, useRef } from 'react'
+import {
+  Form,
+  Link,
+  useActionData,
+  useLoaderData,
+  useNavigation,
+  useSearchParams,
+} from 'react-router'
+import { Button } from '../../src/design-system/components/Button'
+import { Field } from '../../src/design-system/components/Field'
+import { Notice, Panel } from '../../src/design-system/components/Notice'
+import { loadObject, changeLoan } from '../features/loans/routes.server'
+import styles from '../features/projects/projects.module.css'
+import type { Route } from './+types/loans-detail'
+export const loader = ({ request, params }: Route.LoaderArgs) =>
+  loadObject(request, params.objectId)
+export const action = ({ request, params }: Route.ActionArgs) =>
+  changeLoan(request, params.objectId)
+export const meta = () => [{ title: 'Fiche objet — Prêts d’objets' }]
+export default function Detail() {
+  const { object } = useLoaderData<typeof loader>()
+  const feedback = useActionData<typeof action>()
+  const nav = useNavigation()
+  const [search] = useSearchParams()
+  const summary = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    if (feedback) summary.current?.focus()
+  }, [feedback])
+  const notices: Record<string, string> = {
+    created: 'L’objet a été ajouté.',
+    borrowed: 'Le prêt a été enregistré.',
+    returned: 'L’objet a été restitué.',
+  }
+  return (
+    <main className={styles.page}>
+      <Link to="/">Retour à l’inventaire</Link>
+      <h1>{object.name}</h1>
+      <div className={styles.content}>
+        {notices[search.get('notice') ?? ''] && (
+          <Notice tone="success">{notices[search.get('notice')!]}</Notice>
+        )}
+        <Panel>
+          <h2>Fiche de l’objet</h2>
+          <p>{object.category}</p>
+          <p role="status">{object.loan ? `Prêté à ${object.loan.alias}` : 'Disponible'}</p>
+          {object.loan && (
+            <p>Depuis le {new Date(object.loan.borrowedAt).toLocaleDateString('fr-FR')}</p>
+          )}
+        </Panel>
+        <Form method="post" className={styles.form} key={object.loan?.id ?? 'available'}>
+          {feedback && (
+            <div ref={summary} tabIndex={-1}>
+              <Notice tone="error">{feedback.message}</Notice>
+            </div>
+          )}
+          <input type="hidden" name="operation" value={object.loan ? 'return' : 'borrow'} />
+          {!object.loan && (
+            <Field
+              name="alias"
+              label="Alias de démonstration"
+              hint="Utilisez un alias fictif pour cette recette."
+              required
+              maxLength={80}
+              defaultValue={feedback?.values.alias}
+              error={feedback?.errors.alias}
+            />
+          )}
+          <Button type="submit" loading={nav.state === 'submitting'}>
+            {object.loan ? 'Restituer l’objet' : 'Prêter cet objet'}
+          </Button>
+        </Form>
+      </div>
+    </main>
+  )
+}
+
+export { LoanErrorBoundary as ErrorBoundary } from '../features/loans/LoanErrorBoundary'
