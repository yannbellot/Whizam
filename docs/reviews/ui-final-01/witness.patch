new file mode 100644
index 0000000..da0e790
--- /dev/null
+++ b/app/features/loans/http.server.ts
@@ -0,0 +1,80 @@
+import { objectId } from './contracts.ts'
+
+export function assertLocalRequest(request: Request) {
+  const url = new URL(request.url)
+  if (!['127.0.0.1', 'localhost'].includes(url.hostname)) {
+    throw new Response('Requête locale requise.', { status: 403 })
+  }
+}
+
+export function parseObjectId(id: unknown) {
+  const result = objectId.safeParse(id)
+  if (!result.success) throw new Response('Identifiant invalide.', { status: 400 })
+  return result.data
+}
+
+export async function readLoanForm(request: Request) {
+  assertLocalRequest(request)
+  if (request.method !== 'POST')
+    throw new Response('Méthode refusée.', { status: 405, headers: { Allow: 'POST' } })
+  if (
+    request.headers.get('origin') !== new URL(request.url).origin ||
+    request.headers.get('sec-fetch-site') === 'cross-site'
+  ) {
+    throw new Response('Origine refusée.', { status: 403 })
+  }
+  if (
+    request.headers.get('content-type')?.split(';')[0].trim().toLowerCase() !==
+    'application/x-www-form-urlencoded'
+  ) {
+    throw new Response('Format refusé.', { status: 415 })
+  }
+  const declaredSize = Number(request.headers.get('content-length'))
+  if (Number.isFinite(declaredSize) && declaredSize > 16384) {
+    throw new Response('Formulaire trop volumineux.', {
+      status: 413,
+      headers: { Connection: 'close' },
+    })
+  }
+  const reader = request.body?.getReader()
+  const chunks: Uint8Array[] = []
+  let size = 0
+  if (reader) {
+    try {
+      while (true) {
+        const { done, value } = await reader.read()
+        if (done) break
+        size += value.byteLength
+        if (size > 16384) {
+          throw new Response('Formulaire trop volumineux.', {
+            status: 413,
+            headers: { Connection: 'close' },
+          })
+        }
+        chunks.push(value)
+      }
+    } finally {
+      reader.releaseLock()
+    }
+  }
+  const body = new Uint8Array(size)
+  let offset = 0
+  for (const chunk of chunks) {
+    body.set(chunk, offset)
+    offset += chunk.byteLength
+  }
+  let text: string
+  try {
+    text = new TextDecoder('utf-8', { fatal: true }).decode(body)
+  } catch {
+    throw new Response('Formulaire invalide.', { status: 400 })
+  }
+  const fields = new URLSearchParams(text)
+  const seen = new Set<string>()
+  for (const key of fields.keys()) {
+    if (!['name', 'category', 'alias', 'operation'].includes(key) || seen.has(key))
+      throw new Response('Champs invalides.', { status: 400 })
+    seen.add(key)
+  }
+  return Object.fromEntries(fields) as Record<string, string>
+}
diff --git a/app/features/loans/repository.server.ts b/app/features/loans/repository.server.ts
new file mode 100644
index 0000000..9ae3eae
--- /dev/null
+++ b/app/features/loans/repository.server.ts
@@ -0,0 +1,63 @@
+import { and, asc, eq, isNull, isNotNull } from 'drizzle-orm'
+import { createDatabase } from '../../server/db/client.server.ts'
+import { objects, loans } from '../../server/db/schema.server.ts'
+import type { ObjectView } from './contracts.ts'
+let runtime: ReturnType<typeof createDatabase> | undefined
+function db() {
+  runtime ??= createDatabase()
+  return runtime.db
+}
+const active = and(eq(loans.objectId, objects.id), isNull(loans.returnedAt))
+function view(row: {
+  object: typeof objects.$inferSelect
+  loan: typeof loans.$inferSelect | null
+}): ObjectView {
+  return {
+    ...row.object,
+    loan: row.loan
+      ? { id: row.loan.id, alias: row.loan.alias, borrowedAt: row.loan.borrowedAt.toISOString() }
+      : null,
+  }
+}
+export async function listObjects(filter: string) {
+  const rows = await db()
+    .select({ object: objects, loan: loans })
+    .from(objects)
+    .leftJoin(loans, active)
+    .where(
+      filter === 'available'
+        ? isNull(loans.id)
+        : filter === 'loaned'
+          ? isNotNull(loans.id)
+          : undefined,
+    )
+    .orderBy(asc(objects.name), asc(objects.id))
+  return rows.map(view)
+}
+export async function findObject(id: string) {
+  const [row] = await db()
+    .select({ object: objects, loan: loans })
+    .from(objects)
+    .leftJoin(loans, active)
+    .where(eq(objects.id, id))
+  return row ? view(row) : undefined
+}
+export async function addObject(values: { name: string; category: string }) {
+  const [row] = await db().insert(objects).values(values).returning()
+  return row.id
+}
+export async function borrowObject(id: string, alias: string) {
+  await db().insert(loans).values({ objectId: id, alias })
+}
+export async function returnObject(id: string) {
+  const rows = await db()
+    .update(loans)
+    .set({ returnedAt: new Date() })
+    .where(and(eq(loans.objectId, id), isNull(loans.returnedAt)))
+    .returning({ id: loans.id })
+  return rows.length === 1
+}
+export function isConflict(error: unknown): boolean {
+  const e = error as { code?: string; cause?: unknown } | null
+  return !!e && (e.code === '23505' || (e.cause !== undefined && isConflict(e.cause)))
+}
