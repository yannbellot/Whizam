{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-design.local/schemas/semantic-tokens.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tokens"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "value"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^semantic(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"
              },
              "type": {
                "enum": ["color", "dimension", "font-weight"]
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reference"],
                "properties": {
                  "reference": {
                    "type": "string",
                    "pattern": "^(?:primitive|semantic)(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tokens", "styles"],
      "properties": {
        "schemaVersion": {
          "const": 4
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "value"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^semantic(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"
              },
              "type": {
                "enum": ["color", "dimension", "font-weight"]
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reference"],
                "properties": {
                  "reference": {
                    "type": "string",
                    "pattern": "^(?:primitive|semantic)(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"
                  }
                }
              }
            }
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "https://agentic-design.local/schemas/editor-model.schema.json#/$defs/style"
          }
        }
      }
    }
  ]
}
