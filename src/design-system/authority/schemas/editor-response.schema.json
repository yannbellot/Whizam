{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-design.local/schemas/editor-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "enum": ["saved", "invalid", "conflict", "failed", "recovery-required", "pending", "unknown"]
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "enum": [
              "schema-invalid",
              "invalid-value",
              "unknown-reference",
              "incompatible-style",
              "incompatible-intention",
              "style-exists",
              "duplicate-id",
              "id-collision",
              "forbidden-cycle",
              "css-collision",
              "revision-conflict",
              "request-id-reused",
              "recovery-required",
              "write-failed",
              "service-unavailable",
              "forbidden",
              "budget-exceeded",
              "unsupported-format",
              "method-not-allowed"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "target": {
            "type": "string",
            "pattern": "^component(?:\\.[a-z][a-z0-9-]*){2,}$",
            "maxLength": 240
          },
          "style": {
            "type": "string",
            "pattern": "^semantic(?:\\.[a-z][a-z0-9-]*){2,}$",
            "maxLength": 240
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "saved"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["requestId", "revision"],
        "not": {
          "required": ["issues"],
          "properties": {
            "issues": true
          }
        },
        "properties": {
          "requestId": true,
          "revision": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "invalid"
            }
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["requestId"],
        "properties": {
          "requestId": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["invalid", "conflict", "failed", "recovery-required"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["issues"],
        "properties": {
          "issues": true
        }
      }
    }
  ]
}
