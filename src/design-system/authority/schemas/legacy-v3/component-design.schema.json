{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-design.local/schemas/component-design.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "bindings"],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "target": {
      "enum": ["button", "field", "select-field", "notice", "panel", "foundations"]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "$ref": "https://agentic-design.local/schemas/editor-model.schema.json#/$defs/binding"
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "parts", "variants", "states", "consumerFiles", "contrastParts"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "parts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "priorityIntentions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
          }
        },
        "consumerFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:src|app)/[A-Za-z0-9/.-]+\\.(?:css|tsx)$",
            "maxLength": 200
          }
        },
        "contrastParts": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "dynamicConsumers": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "group"],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?:src|app)/[A-Za-z0-9/.-]+\\.(?:css|tsx)$",
                "maxLength": 200
              },
              "group": {
                "const": "legacy-tokens"
              }
            }
          }
        },
        "semanticGuidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "recommendations"],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "recommendations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["variants", "part", "properties", "states", "intentions", "reason"],
                "properties": {
                  "variants": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  },
                  "part": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "properties": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][A-Za-z]+$"
                    }
                  },
                  "states": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  },
                  "intentions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
